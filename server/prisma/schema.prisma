generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PM
  SECRETARY
  TEAM_LEAD
  DEVELOPER
  TECHNICIAN
  HR_MANAGER
  CLIENT
}


model Organization {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  sites        Site[]
  departments  Department[]
  designations Designation[]
  employees    Employee[]
}


model Site {
  id             String       @id @default(uuid())
  name           String
  location       String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  rooms          Room[]
  employees      Employee[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Department {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  teams          Team[]
  employees      Employee[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Team {
  id           String     @id @default(uuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  employees    Employee[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Designation {
  id             String       @id @default(uuid())
  title          String
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  employees      Employee[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}



enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW
  RELEASED
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  CUSTOM
}

enum VisitorStatus {
  EXPECTED
  CHECKED_IN
  WAITING
  HOST_NOTIFIED
  IN_MEETING
  CHECKED_OUT
  CANCELLED
  UNMATCHED
}

enum LeaveType {
  ANNUAL
  SICK
  EMERGENCY
  MATERNITY
  PATERNITY
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
  CUSTOM
}

enum NotificationType {
  BOOKING_APPROVED
  BOOKING_REJECTED
  BOOKING_NO_SHOW
  TICKET_ASSIGNED
  TICKET_ESCALATED
  TICKET_SLA_WARNING
  TICKET_SLA_BREACH
  TICKET_RESOLVED
  VISITOR_ARRIVED
  LEAVE_APPROVED
  LEAVE_REJECTED
  GENERAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  ESCALATED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketCategory {
  IT
  AV_PROJECTOR
  NETWORK
  ACCESS_CONTROL
  HVAC
  WORKSPACE
  VISITOR_RELATED
  HARDWARE
  SOFTWARE
  FACILITY
  GENERAL
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  SUSPENDED
  EXITED
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  TEMPORARY
  INTERN
  CONSULTANT
}


model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  role         Role     @default(CLIENT)
  isActive     Boolean  @default(true)
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Multi-tenancy
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Relations
  bookingsCreated  Booking[]      @relation("BookingCreator")
  ticketsCreated   Ticket[]       @relation("TicketCreator")
  ticketsAssigned  Ticket[]       @relation("TicketAssignee")
  hostedVisitors   Visitor[]      @relation("VisitorHost")
  employeeRecord   Employee?
  notifications    Notification[]
  ticketComments   TicketComment[]
  activityLogs     ActivityLog[]
  approvedLeaves   LeaveRequest[] @relation("LeaveApprover")
}

model Employee {
  id               String           @id @default(uuid())
  employeeId       String?          @unique
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id])
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id])
  siteId           String?
  site             Site?            @relation(fields: [siteId], references: [id])
  departmentId     String?
  department       Department?      @relation(fields: [departmentId], references: [id])
  teamId           String?
  team             Team?            @relation(fields: [teamId], references: [id])
  designationId    String?
  designation      Designation?     @relation(fields: [designationId], references: [id])
  status           EmploymentStatus @default(PROBATION)
  employmentType   EmploymentType   @default(PERMANENT)
  joiningDate      DateTime         @default(now())
  terminationDate  DateTime?
  reportingToId    String?
  reportingTo      Employee?        @relation("ManagerReports", fields: [reportingToId], references: [id])
  reports          Employee[]       @relation("ManagerReports")
  phoneNumber      String?
  emergencyContact String?
  metadata         Json?            // Operational & AI context
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Payroll Readiness Relations
  compensationProfiles CompensationProfile[]
  documents            EmployeeDocument[]
  bankDetails          BankDetail?
  adjustments          PayrollAdjustment[]

  // HR Operations Relations
  leaveRequests  LeaveRequest[]
  leaveBalances  LeaveBalance[]
  shifts         Shift[]
}




model Room {
  id          String   @id @default(uuid())
  name        String
  location    String
  capacity    Int
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Hierarchical link
  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  // Relations
  bookings Booking[]
  tickets  Ticket[]
}


model Booking {
  id              String          @id @default(uuid())
  title           String
  date            DateTime        @db.Date
  startTime       DateTime        @db.Time
  endTime         DateTime        @db.Time
  status          BookingStatus   @default(PENDING)
  notes           String?
  metadata        Json?           // Flexible storage for AI context
  recurrence      RecurrenceType  @default(NONE)
  recurrenceEndDate DateTime?
  parentBookingId String?
  parentBooking   Booking?        @relation("RecurringChildren", fields: [parentBookingId], references: [id])
  childBookings   Booking[]       @relation("RecurringChildren")
  approvedById    String?
  rejectedReason  String?
  noShowFlaggedAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id])
  createdById String
  createdBy   User      @relation("BookingCreator", fields: [createdById], references: [id])
  tickets     Ticket[]
  visitors    Visitor[]
}

model Ticket {
  id               String         @id @default(uuid())
  title            String
  description      String
  category         TicketCategory
  priority         TicketPriority @default(MEDIUM)
  status           TicketStatus   @default(OPEN)
  metadata         Json?          // Flexible storage for AI context
  resolutionNote   String?
  responseDueAt    DateTime?      // SLA response deadline
  resolutionDueAt  DateTime?      // SLA resolution deadline
  slaBreached      Boolean        @default(false)
  closedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Relations
  createdById  String
  createdBy    User            @relation("TicketCreator", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?           @relation("TicketAssignee", fields: [assignedToId], references: [id])
  bookingId    String?
  booking      Booking?        @relation(fields: [bookingId], references: [id])
  roomId       String?
  room         Room?           @relation(fields: [roomId], references: [id])
  visitorId    String?
  visitor      Visitor?        @relation(fields: [visitorId], references: [id])
  comments     TicketComment[]
}

model Visitor {
  id           String        @id @default(uuid())
  name         String
  email        String?
  phone        String?
  company      String?
  status       VisitorStatus @default(EXPECTED)
  checkInTime  DateTime?
  checkOutTime DateTime?
  isWalkIn     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  hostId    String
  host      User     @relation("VisitorHost", fields: [hostId], references: [id])
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])
  tickets   Ticket[]
}

model EmployeeDocument {
  id         String   @id @default(uuid())
  title      String
  fileUrl    String
  expiryDate DateTime?
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BankDetail {
  id            String   @id @default(uuid())
  bankName      String
  accountNumber String
  accountName   String
  branchCode    String?
  employeeId    String   @unique
  employee      Employee @relation(fields: [employeeId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CompensationProfile {
  id             String   @id @default(uuid())
  baseSalary     Decimal  @db.Decimal(12, 2)
  currency       String   @default("KES")
  payFrequency   String   @default("MONTHLY")
  effectiveDate  DateTime @default(now())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PayrollPeriod {
  id          String              @id @default(uuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  isClosed    Boolean             @default(false)
  adjustments PayrollAdjustment[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model PayrollAdjustment {
  id              String         @id @default(uuid())
  type            String
  amount          Decimal        @db.Decimal(12, 2)
  reason          String
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// ─── Ticket Comments ─────────────────────────────────────────────────────────

model TicketComment {
  id         String   @id @default(uuid())
  body       String
  isInternal Boolean  @default(false) // staff-only note
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id])
}

// ─── SLA Engine ─────────────────────────────────────────────────────────────

model SlaRule {
  id                String          @id @default(uuid())
  name              String
  priority          TicketPriority
  category          TicketCategory? // Null = applies to all categories with this priority
  responseMinutes   Int             // Due time for initial assignment/response
  resolutionMinutes Int             // Due time for resolving the ticket
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([priority, category])
}



// ─── Activity Log ─────────────────────────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(uuid())
  action     String   // e.g. "BOOKING_CREATED", "TICKET_ASSIGNED"
  entityType String   // e.g. "Booking", "Ticket", "Visitor"
  entityId   String
  metadata   Json?    // diff, context, AI features
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  userId String?
  user   User?  @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}


// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  metadata  Json?            // link to entity (bookingId, ticketId, etc.)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}


// ─── Leave Management ─────────────────────────────────────────────────────────

model LeaveRequest {
  id          String      @id @default(uuid())
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  status      LeaveStatus @default(PENDING)
  reason      String
  reviewNote  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  approverId String?
  approver   User?    @relation("LeaveApprover", fields: [approverId], references: [id])
}


model LeaveBalance {
  id            String    @id @default(uuid())
  year          Int
  leaveType     LeaveType
  totalDays     Float
  usedDays      Float     @default(0)
  remainingDays Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, year, leaveType])
}


// ─── Shifts & Rosters ─────────────────────────────────────────────────────────

model Shift {
  id        String    @id @default(uuid())
  date      DateTime  @db.Date
  startTime DateTime  @db.Time
  endTime   DateTime  @db.Time
  type      ShiftType @default(MORNING)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
}
