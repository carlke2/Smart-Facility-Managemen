generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PM
  SECRETARY
  TEAM_LEAD
  DEVELOPER
  TECHNICIAN
  HR_MANAGER
  CLIENT
}


model Organization {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  sites        Site[]
  departments  Department[]
  designations Designation[]
  employees    Employee[]
}


model Site {
  id             String       @id @default(uuid())
  name           String
  location       String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  rooms          Room[]
  employees      Employee[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Department {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  teams          Team[]
  employees      Employee[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Team {
  id           String     @id @default(uuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  employees    Employee[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Designation {
  id             String       @id @default(uuid())
  title          String
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  employees      Employee[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}



enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  ESCALATED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketCategory {
  HARDWARE
  SOFTWARE
  NETWORK
  FACILITY
  OTHER
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  SUSPENDED
  EXITED
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  TEMPORARY
  INTERN
  CONSULTANT
}


model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CLIENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenancy
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Relations
  bookingsCreated Booking[] @relation("BookingCreator")
  ticketsCreated  Ticket[]  @relation("TicketCreator")
  ticketsAssigned Ticket[]  @relation("TicketAssignee")
  hostedVisitors  Visitor[] @relation("VisitorHost")
  employeeRecord Employee?
}

model Employee {
  id               String           @id @default(uuid())
  employeeId       String?          @unique
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id])
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id])
  siteId           String?
  site             Site?            @relation(fields: [siteId], references: [id])
  departmentId     String?
  department       Department?      @relation(fields: [departmentId], references: [id])
  teamId           String?
  team             Team?            @relation(fields: [teamId], references: [id])
  designationId    String?
  designation      Designation?     @relation(fields: [designationId], references: [id])
  status           EmploymentStatus @default(PROBATION)
  employmentType   EmploymentType   @default(PERMANENT)
  joiningDate      DateTime         @default(now())
  terminationDate  DateTime?
  reportingToId    String?
  reportingTo      Employee?        @relation("ManagerReports", fields: [reportingToId], references: [id])
  reports          Employee[]       @relation("ManagerReports")
  phoneNumber      String?
  emergencyContact String?
  metadata         Json?            // Operational & AI context
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Payroll Readiness Relations
  compensationProfiles CompensationProfile[]
  documents            EmployeeDocument[]
  bankDetails          BankDetail?
}



model Room {
  id          String   @id @default(uuid())
  name        String
  location    String
  capacity    Int
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Hierarchical link
  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  // Relations
  bookings Booking[]
  tickets  Ticket[]
}


model Booking {
  id        String        @id @default(uuid())
  title     String
  date      DateTime      @db.Date
  startTime DateTime      @db.Time
  endTime   DateTime      @db.Time
  status    BookingStatus @default(PENDING)
  notes     String?
  metadata  Json? // Flexible storage for AI context
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id])
  createdById String
  createdBy   User      @relation("BookingCreator", fields: [createdById], references: [id])
  tickets     Ticket[]
  visitors    Visitor[]
}

model Ticket {
  id          String         @id @default(uuid())
  title       String
  description String
  category    TicketCategory
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  metadata    Json? // Flexible storage for AI context
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt


  // Relations
  createdById  String
  createdBy    User     @relation("TicketCreator", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?    @relation("TicketAssignee", fields: [assignedToId], references: [id])
  bookingId    String?
  booking      Booking? @relation(fields: [bookingId], references: [id])
  roomId       String?
  room         Room?    @relation(fields: [roomId], references: [id])
  visitorId    String?
  visitor      Visitor? @relation(fields: [visitorId], references: [id])
}

model Visitor {
  id          String    @id @default(uuid())
  name        String
  checkInTime DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  hostId      String
  host        User      @relation("VisitorHost", fields: [hostId], references: [id])
  bookingId   String?
  booking     Booking?  @relation(fields: [bookingId], references: [id])
  tickets     Ticket[]
}

model EmployeeDocument {
  id         String   @id @default(uuid())
  title      String
  fileUrl    String
  expiryDate DateTime?
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BankDetail {
  id            String   @id @default(uuid())
  bankName      String
  accountNumber String
  accountName   String
  branchCode    String?
  employeeId    String   @unique
  employee      Employee @relation(fields: [employeeId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CompensationProfile {
  id             String   @id @default(uuid())
  baseSalary     Decimal  @db.Decimal(12, 2)
  currency       String   @default("KES")
  payFrequency   String   @default("MONTHLY")
  effectiveDate  DateTime @default(now())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PayrollPeriod {
  id          String              @id @default(uuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  isClosed    Boolean             @default(false)
  adjustments PayrollAdjustment[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model PayrollAdjustment {
  id              String         @id @default(uuid())
  type            String
  amount          Decimal        @db.Decimal(12, 2)
  reason          String
  employeeId      String
  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

